# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (for Render.com deployment)
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database Configuration (Neon)
# Get from: https://neon.tech → Your Project → Connection Details
POSTGRES_URL=postgresql://username:password@host.region.neon.tech/database?sslmode=require

# Neo4j Aura Configuration
# Get from: https://console.neo4j.io → your instance → Connect tab
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Google Gemini AI Configuration
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration (for Voice Features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (for Vercel deployment)
# ============================================================================

# Backend API URL (set to your Render backend URL in production)
# Local: http://localhost:3001/api
# Production: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# Cloudinary Configuration (Optional - for image uploads)
# Get from: https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Recraft AI Configuration (Optional - for image generation)
# Get from: https://www.recraft.ai → API Settings
VITE_RECRAFT_API_URL=https://external.api.recraft.ai/v1
VITE_RECRAFT_API_KEY=your_recraft_api_key_here